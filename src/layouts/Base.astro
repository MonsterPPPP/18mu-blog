---
const { title = '18mu-blog', description = '个人知识站', section } = Astro.props;
const nav = [
  { label: '博客', href: '/blog', key: 'blog' },
  { label: '项目', href: '/projects', key: 'projects' },
  { label: '经历', href: '/resume', key: 'resume' },
  { label: 'For Agent', href: '/agent', key: 'agent' }
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f3ed" />
    <title>{title}</title>
    <link rel="icon" href="data:,18mu" />
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="18mu-blog 首页"><span class="brand-mark">18</span><span>mu</span><i>blog</i></a>
        <details class="mobile-nav"><summary aria-label="打开站点导航"><span></span><span></span><span></span></summary><nav aria-label="主导航">{nav.map((item) => <a class:list={["nav-link", { active: section === item.key }]} href={item.href}>{item.label}</a>)}</nav></details>
        <nav class="desktop-nav" aria-label="主导航">{nav.map((item) => <a class:list={["nav-link", { active: section === item.key }]} href={item.href}>{item.label}</a>)}</nav>
        <a class="header-walk" href="/walk">随机漫步 <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main class="shell"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <p><span class="footer-mark">18mu</span> 一个持续生长的个人内容空间</p>
        <div><a href="/blog">知识库</a><a href="/map">认知地图</a><a href="/agent">For Agent</a><a href="/rss.xml">RSS</a></div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root { --canvas:#f6f3ed; --surface:#fffdf9; --ink:#18201e; --muted:#69736e; --line:#dedbd2; --soft:#ece9e1; --mint:#d8ebe4; --mint-deep:#146b5f; --sky:#dceaf0; --coral:#e87055; --serif: Georgia, "Noto Serif SC", "Songti SC", serif; --sans: "Inter", "Noto Sans SC", "PingFang SC", system-ui, sans-serif; }
  * { box-sizing:border-box; }
  html { background:var(--canvas); scroll-behavior:smooth; }
  body { min-width:320px; margin:0; background:var(--canvas); color:var(--ink); font-family:var(--serif); font-size:17px; line-height:1.75; }
  a { color:inherit; text-underline-offset:3px; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  .shell { width:min(1160px, calc(100% - 48px)); margin:0 auto; }
  .site-header { position:sticky; top:0; z-index:20; border-bottom:1px solid var(--line); background:color-mix(in srgb, var(--canvas) 92%, transparent); backdrop-filter:blur(12px); }
  .header-inner { height:72px; display:flex; align-items:center; gap:34px; }
  .brand { display:inline-flex; align-items:baseline; gap:1px; text-decoration:none; font:800 21px/1 var(--sans); letter-spacing:0; white-space:nowrap; }
  .brand-mark { color:var(--mint-deep); }.brand i { margin-left:4px; color:var(--muted); font:500 12px/1 var(--sans); font-style:normal; }
  nav { display:flex; align-items:center; gap:25px; }.mobile-nav { display:none; }
  .nav-link { position:relative; padding:5px 0; color:#4e5853; font:500 14px/1 var(--sans); text-decoration:none; }
  .nav-link:hover,.nav-link.active { color:var(--ink); }.nav-link.active::after { position:absolute; right:0; bottom:-15px; left:0; height:2px; background:var(--mint-deep); content:""; }
  .header-walk { margin-left:auto; color:var(--mint-deep); font:650 13px/1 var(--sans); text-decoration:none; }.header-walk span { margin-left:5px; font-size:17px; }
  main { min-height:calc(100vh - 206px); padding-block:56px 84px; }
  .site-footer { border-top:1px solid var(--line); }.footer-inner { display:flex; justify-content:space-between; gap:24px; padding-block:25px; color:var(--muted); font:13px/1.5 var(--sans); }.footer-inner p { margin:0; }.footer-mark { color:var(--ink); font-weight:700; }.footer-inner div { display:flex; gap:18px; }.footer-inner a { text-decoration:none; }.footer-inner a:hover { color:var(--mint-deep); }
  h1,h2,h3 { letter-spacing:0; } h1 { margin:10px 0 16px; font-size:clamp(38px, 5vw, 64px); line-height:1.16; } h2 { line-height:1.32; } h3 { line-height:1.4; }
  .eyebrow { color:var(--mint-deep); font:700 11px/1.2 var(--sans); letter-spacing:1.3px; text-transform:uppercase; }.eyebrow::before { display:inline-block; width:18px; height:1px; margin:0 8px 3px 0; background:currentColor; content:""; }
  .page-intro { max-width:650px; margin-bottom:44px; }.page-intro h1 { margin-bottom:10px; }.page-intro p { margin:0; color:var(--muted); }
  .hero { display:grid; grid-template-columns:minmax(0, 1.2fr) minmax(245px, .8fr); gap:42px; align-items:end; padding:52px 0 72px; }.hero h1 { max-width:700px; margin:12px 0 20px; font-size:clamp(46px, 6vw, 78px); line-height:1.08; }.hero-copy { max-width:680px; margin:0; color:var(--muted); font-size:19px; }.hero-note { padding:22px 0 5px 25px; border-left:1px solid var(--mint-deep); color:#52605a; font-size:15px; }.hero-note strong { display:block; margin-bottom:4px; color:var(--ink); font-family:var(--sans); font-size:13px; }
  .section-heading { display:flex; align-items:baseline; justify-content:space-between; gap:20px; margin:0 0 17px; }.section-heading h2 { margin:0; font-size:26px; }.section-heading a { color:var(--mint-deep); font:600 13px var(--sans); text-decoration:none; }
  .home-grid { display:grid; grid-template-columns:1.08fr .92fr; gap:16px; }.home-card { position:relative; min-height:210px; padding:25px; overflow:hidden; border:1px solid var(--line); background:var(--surface); text-decoration:none; transition:transform .2s ease, border-color .2s ease; }.home-card:hover { border-color:#a8bfb6; transform:translateY(-3px); }.home-card h3 { max-width:75%; margin:17px 0 8px; font-size:27px; }.home-card p { max-width:85%; margin:0; color:var(--muted); font-size:15px; }.home-card .card-arrow { position:absolute; right:24px; bottom:20px; color:var(--mint-deep); font:600 24px/1 var(--sans); }.home-card.featured { grid-row:span 2; min-height:436px; background:var(--ink); color:#fbfaf5; }.home-card.featured h3 { margin-top:80px; font-size:36px; }.home-card.featured p { color:#ced7d1; }.home-card.featured .eyebrow,.home-card.featured .card-arrow { color:#a9d6c8; }.home-card.map-card { background:var(--sky); }.home-card.agent-card { background:var(--mint); }
  .list { display:grid; gap:0; }.entry { display:grid; grid-template-columns:145px minmax(0, 1fr); gap:28px; padding:25px 0; border-top:1px solid var(--line); }.entry:last-child { border-bottom:1px solid var(--line); }.entry-meta { padding-top:6px; color:var(--muted); font:12px/1.55 var(--sans); }.entry-meta time { display:block; margin-top:5px; }.entry h2 { margin:0 0 7px; font-size:28px; }.entry h2 a { text-decoration:none; }.entry h2 a:hover { color:var(--mint-deep); }.entry p { margin:0 0 13px; color:var(--muted); }.meta { color:var(--muted); font:13px/1.5 var(--sans); }.tag { display:inline-block; margin:2px 5px 0 0; padding:2px 7px; border:1px solid #c4d9d1; color:#35655b; background:#edf6f2; font:11px/1.5 var(--sans); }
  .prose { width:min(740px, 100%); }.article-header { margin-bottom:36px; padding-bottom:28px; border-bottom:1px solid var(--line); }.article-header h1 { margin:13px 0 14px; font-size:clamp(40px, 5.3vw, 64px); }.article-summary { margin:0 0 19px; color:var(--muted); font-size:20px; line-height:1.65; }.article-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:24px; }.action-link { display:inline-flex; align-items:center; gap:7px; min-height:36px; padding:7px 12px; border:1px solid var(--line); background:var(--surface); color:var(--ink); font:600 12px var(--sans); text-decoration:none; }.action-link:hover { border-color:var(--mint-deep); color:var(--mint-deep); }.prose :where(h2) { margin:44px 0 13px; font-size:29px; }.prose :where(h3) { margin:31px 0 8px; font-size:21px; }.prose :where(p,ul,ol) { margin:0 0 20px; }.prose :where(ul,ol) { padding-left:1.35em; }.prose :where(blockquote) { margin:26px 0; padding:4px 0 4px 20px; border-left:3px solid var(--mint-deep); color:var(--muted); }.prose :where(code) { padding:2px 5px; background:var(--soft); font:13px ui-monospace, monospace; }.prose :where(pre) { overflow:auto; padding:18px; background:#202725; color:#edf1ef; }.prose :where(img) { max-width:100%; height:auto; }.prose :where(a) { color:var(--mint-deep); }
  .project-en { color:var(--muted); font:400 .64em var(--sans); }.project-body { margin-top:18px; color:var(--muted); }.project-body :where(p,ol,ul) { margin:0 0 14px; }.project-body :where(ol,ul) { padding-left:1.25em; }
  .tool-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; margin-top:34px; }.tool-card { min-height:178px; padding:24px; border:1px solid var(--line); background:var(--surface); text-decoration:none; }.tool-card h2 { margin:25px 0 8px; font-size:24px; }.tool-card p { margin:0; color:var(--muted); font-size:15px; }.tool-card .tool-index { color:var(--coral); font:700 12px var(--sans); }
  .empty-state { max-width:570px; margin:48px auto; padding:30px; border:1px dashed #b7c4be; background:var(--surface); text-align:center; }.empty-state h2 { margin:0 0 8px; font-size:23px; }.empty-state p { margin:0; color:var(--muted); font-size:15px; }.notice { padding:20px 22px; border-left:3px solid var(--mint-deep); background:var(--mint); }.notice p { margin:6px 0 0; }
  .search { position:relative; margin:0 0 34px; }.search-input { width:100%; min-height:50px; padding:11px 43px 11px 15px; border:1px solid var(--line); border-radius:0; outline:none; background:var(--surface); color:var(--ink); font:15px var(--sans); }.search-input:focus { border-color:var(--mint-deep); box-shadow:0 0 0 3px #d8ebe48c; }.search-icon { position:absolute; top:14px; right:16px; color:var(--muted); }.search-results { margin-top:10px; border:1px solid var(--line); background:var(--surface); }.search-result { display:block; padding:13px 15px; border-bottom:1px solid var(--soft); color:var(--ink); font:14px var(--sans); text-decoration:none; }.search-result:last-child { border:0; }.search-result:hover { background:var(--mint); }.search-result small { display:block; margin-top:2px; color:var(--muted); }.search-empty { margin:0; padding:15px; color:var(--muted); font:14px var(--sans); }
  .taxonomy { display:grid; gap:12px; margin:-7px 0 34px; }.taxonomy > div { display:flex; flex-wrap:wrap; align-items:center; gap:8px; }.taxonomy .eyebrow { min-width:62px; margin-right:5px; }.taxonomy a { padding:3px 8px; border:1px solid var(--line); color:#35655b; background:var(--surface); font:12px var(--sans); text-decoration:none; }.taxonomy a:hover { border-color:var(--mint-deep); background:var(--mint); }.text-link { display:inline-flex; gap:7px; color:var(--mint-deep); font:700 13px var(--sans); text-decoration:none; }.text-link:hover { text-decoration:underline; }.project-detail { max-width:800px; }.project-summary-en { font-family:var(--sans); font-size:16px; }.record-links { margin:44px 0 0; padding:25px; border:1px solid var(--line); background:var(--surface); }.record-links h2 { margin:12px 0 20px; font-size:25px; }.record-links h3 { margin:20px 0 6px; color:var(--muted); font:700 11px var(--sans); letter-spacing:1px; text-transform:uppercase; }.record-links a { display:flex; justify-content:space-between; gap:14px; padding:10px 0; border-bottom:1px solid var(--soft); color:var(--ink); font:600 14px var(--sans); text-decoration:none; }.record-links a:hover { color:var(--mint-deep); }.record-links a span { margin-left:auto; color:var(--muted); font-weight:400; }.record-links a b { color:var(--mint-deep); }.resume-stack { display:grid; gap:48px; }.resume-record { max-width:800px; }.resume-record .article-header { margin-bottom:27px; }.resume-record .article-header h2 { margin:9px 0 0; font-size:34px; }
  .map-loading { display:flex; justify-content:center; align-items:center; gap:10px; min-height:340px; color:var(--muted); font:14px var(--sans); }.spin { animation:spin .85s linear infinite; }@keyframes spin { to { transform:rotate(1turn); } }.empty-state svg { color:var(--mint-deep); }.knowledge-map { display:grid; grid-template-columns:minmax(0, 1fr) 290px; min-height:510px; border:1px solid var(--line); background:var(--surface); }.map-canvas { position:relative; min-height:510px; overflow:hidden; background:linear-gradient(135deg, #eff5f1, #f9faf7 54%, #e8f0ed); }.map-canvas::before { position:absolute; inset:0; background-image:radial-gradient(#9db6ab 1px, transparent 1px); background-size:22px 22px; opacity:.25; content:""; }.map-canvas svg { position:absolute; inset:0; width:100%; height:100%; }.map-canvas line { stroke:#89a99d; stroke-width:.28; }.map-node { position:absolute; z-index:1; width:12px; height:12px; padding:0; border:2px solid #fff; border-radius:50%; outline:0; background:var(--node-color); box-shadow:0 1px 5px #26443b4d; cursor:pointer; transform:translate(-50%, -50%); transition:transform .16s ease, width .16s ease, height .16s ease; }.map-node span { position:absolute; bottom:16px; left:50%; width:max-content; max-width:140px; color:var(--ink); font:600 11px/1.25 var(--sans); opacity:0; pointer-events:none; transform:translateX(-50%); transition:opacity .16s; }.map-node:hover,.map-node:focus-visible,.map-node.selected,.map-node.linked { width:17px; height:17px; }.map-node:hover span,.map-node:focus-visible span,.map-node.selected span { opacity:1; }.map-node:focus-visible { outline:3px solid var(--ink); outline-offset:2px; }.map-node.selected { z-index:3; border-color:var(--ink); }.map-caption { position:absolute; right:16px; bottom:12px; z-index:2; max-width:260px; margin:0; color:#52605a; font:11px/1.45 var(--sans); text-align:right; }.map-inspector { display:flex; flex-direction:column; padding:30px 25px; border-left:1px solid var(--line); }.map-inspector h2 { margin:14px 0 9px; font-size:27px; }.map-inspector p { margin:0 0 17px; color:var(--muted); font-size:14px; line-height:1.65; }.map-date { margin-top:auto!important; font:12px var(--sans); }.map-read,.walk-current > a { display:inline-flex; align-items:center; gap:6px; margin-top:22px; color:var(--mint-deep); font:700 13px var(--sans); text-decoration:none; }.map-reset,.walk-restart { display:flex; align-items:center; gap:6px; width:max-content; margin-top:15px; padding:0; border:0; background:none; color:var(--muted); font:12px var(--sans); cursor:pointer; }.walk-tool { display:grid; grid-template-columns:.78fr 1.22fr; overflow:hidden; border:1px solid var(--line); background:var(--surface); }.walk-path { grid-column:1 / -1; display:flex; align-items:center; gap:8px; min-height:48px; padding:11px 25px; border-bottom:1px solid var(--line); color:var(--muted); font:12px var(--sans); }.walk-dot { display:inline-grid; width:22px; height:22px; place-items:center; border-radius:50%; background:var(--mint); color:var(--mint-deep); font-weight:700; }.walk-current { padding:35px 30px; border-right:1px solid var(--line); }.walk-current h2 { margin:14px 0 8px; font-size:32px; line-height:1.25; }.walk-current p { color:var(--muted); font-size:15px; }.walk-next { padding:35px 30px; }.walk-next h3 { margin:12px 0 21px; font-size:25px; }.walk-options { display:grid; gap:8px; }.walk-options button { display:grid; grid-template-columns:1fr auto; gap:3px 12px; padding:13px 0; border:0; border-bottom:1px solid var(--line); background:none; color:var(--ink); text-align:left; font:600 15px var(--sans); cursor:pointer; }.walk-options button:hover span { color:var(--mint-deep); }.walk-options small { color:var(--muted); font:11px var(--sans); }.walk-options svg { grid-column:2; grid-row:1 / 3; align-self:center; color:var(--mint-deep); }.walk-end { color:var(--muted); font-size:14px; }
  @media (max-width:720px) { .shell { width:min(100% - 32px, 1160px); }.header-inner { height:68px; gap:15px; }.desktop-nav { display:none; }.mobile-nav { display:block; margin-left:auto; }.mobile-nav summary { display:grid; gap:4px; width:38px; padding:9px; cursor:pointer; list-style:none; }.mobile-nav summary::-webkit-details-marker { display:none; }.mobile-nav summary span { display:block; height:1px; background:var(--ink); }.mobile-nav nav { position:absolute; top:68px; right:16px; display:grid; min-width:185px; padding:10px 18px; border:1px solid var(--line); background:var(--surface); box-shadow:0 12px 22px #18201e1a; }.mobile-nav .nav-link { padding:12px 0; border-bottom:1px solid var(--soft); }.mobile-nav .nav-link:last-child { border:0; }.nav-link.active::after { right:auto; width:3px; bottom:9px; left:-10px; height:18px; }.header-walk { margin-left:0; }.hero,.home-grid { grid-template-columns:1fr; }.hero { gap:24px; padding:30px 0 55px; }.hero-note { max-width:500px; }.home-card.featured { min-height:300px; }.home-card.featured h3 { margin-top:45px; }.entry { grid-template-columns:1fr; gap:5px; padding:20px 0; }.entry-meta { padding:0; }.entry-meta time { display:inline; margin-left:6px; }.entry h2 { font-size:24px; }.tool-grid { grid-template-columns:1fr; }.knowledge-map,.walk-tool { grid-template-columns:1fr; }.map-canvas { min-height:410px; }.map-inspector,.walk-current { border:0; border-top:1px solid var(--line); }.walk-current,.walk-next { padding:27px 22px; }.footer-inner { align-items:flex-start; flex-direction:column; }.footer-inner div { flex-wrap:wrap; gap:11px 17px; } main { padding-block:35px 60px; }.record-links { padding:20px; } }
</style>
