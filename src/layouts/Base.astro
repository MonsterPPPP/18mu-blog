---
const { title = '18mu-blog', description = '个人知识站' } = Astro.props;
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title}</title><link rel="icon" href="data:,18mu"/></head><body><header><a class="brand" href="/">18mu<span>blog</span></a><nav aria-label="主导航"><a href="/blog">博客</a><a href="/projects">项目</a><a href="/resume">经历</a><a href="/agent">For Agent</a></nav></header><main><slot /></main><footer>18mu-blog · Markdown first · Cloudflare deployed</footer></body></html>
<style is:global>
:root{--paper:#f5f1e8;--ink:#17211f;--muted:#64716b;--line:#d7d2c7;--accent:#0d6b5f;--blue:#266d9c}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:Georgia,"Noto Serif SC",serif;line-height:1.65}header,main,footer{max-width:1120px;margin:auto;padding-inline:24px}header{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{font:bold 24px ui-sans-serif,sans-serif;letter-spacing:0;text-decoration:none;color:var(--ink)}.brand span{color:var(--accent)}nav{display:flex;gap:20px}a{color:var(--accent)}nav a{text-decoration:none;color:var(--ink);font:14px ui-sans-serif,sans-serif}main{min-height:calc(100vh - 156px);padding-block:60px}footer{border-top:1px solid var(--line);padding-block:20px;color:var(--muted);font-size:13px}.eyebrow{color:var(--accent);font:700 12px ui-sans-serif,sans-serif;text-transform:uppercase;letter-spacing:1px}.hero{max-width:780px;padding:50px 0 65px}.hero h1{font-size:clamp(42px,7vw,78px);line-height:1.05;margin:10px 0 22px}.hero p{font-size:20px;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.card{border:1px solid var(--line);padding:24px;background:#fbf9f3}.card h2{margin:0 0 8px;font-size:24px}.card p{color:var(--muted)}.meta{font:13px ui-sans-serif,sans-serif;color:var(--muted)}.list{display:grid;gap:14px}.list article{border-bottom:1px solid var(--line);padding:0 0 16px}.list h2{margin:0;font-size:26px}.tag{font:12px ui-sans-serif,sans-serif;background:#d9ebe4;padding:3px 8px;margin-right:5px}.prose{max-width:760px}.notice{border-left:4px solid var(--blue);background:#e8f0f2;padding:20px}@media(max-width:640px){header{height:auto;padding-block:17px;align-items:flex-start;gap:14px}nav{gap:12px;flex-wrap:wrap}.grid{grid-template-columns:1fr}main{padding-block:35px}}
</style>
