---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogSearch from '../../components/BlogSearch';
const slug = (id: string) => id.replace(/\.md$/, '');
const posts = (await getCollection('blog', ({ data }) => data.published)).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
const items = posts.map((post) => ({ title: post.data.title, description: post.data.description, href: `/blog/${slug(post.id)}`, tags: post.data.tags, category: post.data.category }));
const categories = [...new Set(posts.map((post) => post.data.category))];
const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
---
<Base title="博客 | 18mu-blog" section="blog"><section class="page-intro"><div class="eyebrow">Blog / Knowledge base</div><h1>博客与知识库</h1><p>这里保存完成写作后的中文定稿。文章是知识库的节点，也是再次思考的起点。</p></section><BlogSearch client:load items={items}/><div class="taxonomy"><div><span class="eyebrow">分类</span>{categories.map((category) => <a href={`/blog/category/${encodeURIComponent(category)}`}>{category}</a>)}</div><div><span class="eyebrow">标签</span>{tags.map((tag) => <a href={`/blog/tag/${encodeURIComponent(tag)}`}>#{tag}</a>)}</div></div><div class="list">{posts.map((post) => <article class="entry"><div class="entry-meta"><a href={`/blog/category/${encodeURIComponent(post.data.category)}`}>{post.data.category}</a><time>更新于 {post.data.updated.toLocaleDateString('zh-CN')}</time></div><div><h2><a href={`/blog/${slug(post.id)}`}>{post.data.title}</a></h2><p>{post.data.description}</p><div>{post.data.tags.map((tag) => <a class="tag" href={`/blog/tag/${encodeURIComponent(tag)}`}>{tag}</a>)}</div></div></article>)}</div><section class="tool-grid"><a class="tool-card" href="/map"><span class="tool-index">KNOWLEDGE 01</span><h2>认知地图</h2><p>把全部文章放回同一片语义空间，找到主题之间的邻近与距离。</p></a><a class="tool-card" href="/walk"><span class="tool-index">KNOWLEDGE 02</span><h2>随机漫步</h2><p>从一篇内容开始，沿系统发现的相关线索继续走下去。</p></a></section></Base>
