---
import { getCollection, render } from 'astro:content'; import Base from '../../layouts/Base.astro'; export async function getStaticPaths(){return (await getCollection('blog',({data})=>data.published)).map(p=>({params:{slug:p.id.replace(/\.md$/, '')},props:{post:p}}));}const{post}=Astro.props;const{Content}=await render(post);
---
<Base title={`${post.data.title} | 18mu-blog`}><article class="prose"><div class="meta">{post.data.category} · 最后更新 {post.data.updated.toLocaleDateString('zh-CN')}</div><h1>{post.data.title}</h1><p>{post.data.description}</p><div>{post.data.tags.map(t=><span class="tag">{t}</span>)}</div><Content /></article></Base>
