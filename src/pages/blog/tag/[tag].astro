---
import Base from '../../../layouts/Base.astro';
import { articleHref, publishedPosts } from '../../../lib/content';
export async function getStaticPaths() { const names = new Set((await publishedPosts()).flatMap((post) => post.data.tags)); return [...names].map((tag) => ({ params: { tag: encodeURIComponent(tag) }, props: { tag } })); }
const { tag } = Astro.props; const posts = (await publishedPosts()).filter((post) => post.data.tags.includes(tag));
---
<Base title={`#${tag} | 18mu-blog`} section="blog"><section class="page-intro"><div class="eyebrow">Tag</div><h1>#{tag}</h1><p>{posts.length} 篇公开文章。</p></section><div class="list">{posts.map((post) => <article class="entry"><div class="entry-meta"><a href={`/blog/category/${encodeURIComponent(post.data.category)}`}>{post.data.category}</a><time>{post.data.updated.toLocaleDateString('zh-CN')}</time></div><div><h2><a href={articleHref(post.id)}>{post.data.title}</a></h2><p>{post.data.description}</p>{post.data.tags.map((item) => <a class="tag" href={`/blog/tag/${encodeURIComponent(item)}`}>{item}</a>)}</div></article>)}</div></Base>
