---
import Base from '../layouts/Base.astro';
import { projectHref, publishedProjects } from '../lib/content';
const entries = await publishedProjects();
---
<Base title="项目 | 18mu-blog" description="个人项目与实践记录" section="projects">
  <section class="page-intro"><div class="eyebrow">Projects</div><h1>项目</h1><p>持续做过的事与正在发展的想法。每一个项目保留中英双语的公开说明，并与相关经历形成可追溯的阅读路径。</p></section>
  {entries.length ? <div class="list">{entries.map((project) => <article class="entry"><div class="entry-meta">{project.data.status}<time>更新于 {project.data.updated.toLocaleDateString('zh-CN')}</time></div><div><h2><a href={projectHref(project.id)}>{project.data.title}</a> <span class="project-en">{project.data.titleEn}</span></h2><p>{project.data.summary}</p><p class="project-en">{project.data.summaryEn}</p><a class="text-link" href={projectHref(project.id)}>查看项目记录 <span aria-hidden="true">→</span></a></div></article>)}</div> : <section class="empty-state"><h2>项目记录正在整理</h2><p>这里会展示公开的中英双语项目说明。</p></section>}
</Base>
